# TasmoAdmin environment
#
# Copy this file to .env next to your docker-compose.yml, adjust it, and load
# it in the tasmoadmin service with:
#
#   env_file:
#     - .env
#
# Lines starting with # are ignored. The enabled lines below are the defaults;
# the commented ones are optional and only needed if you want to change them.
# Keep .env private (chmod 600): it can contain the password key and the
# database password.


# --- Database ---------------------------------------------------------------

# Where devices, settings, device backups and snapshots are stored.
# The default is an SQLite file in the data volume. For MariaDB/MySQL or
# PostgreSQL use one of the commented examples instead (the database must
# exist; TasmoAdmin creates its own ta_* tables in it):
#   mysql://tasmoadmin:secret@mariadb.example:3306/tasmoadmin
#   postgres://tasmoadmin:secret@postgres.example:5432/tasmoadmin?sslmode=require
# Special characters in the password must be URL-encoded (@ as %40, : as %3A).
# The default below is the path in the Docker image; outside Docker remove the
# line, and the SQLite file is created in the data directory.
TASMO_DB_URI=sqlite:////data/tasmoadmin/tasmoadmin.db

# Read the database URI from a file instead, e.g. a Docker secret. If both
# TASMO_DB_URI and this are set, they must contain the same URI.
#TASMO_DB_URI_FILE=/run/secrets/tasmoadmin_db_uri

# Set to "files" to keep devices and settings in devices.csv and
# MyConfig.json instead of a database (no snapshots or database export then).
#TASMO_STORAGE=files


# --- Password encryption ----------------------------------------------------

# Key that encrypts the device passwords and the MQTT password stored by
# TasmoAdmin: a base64-encoded 32-byte value. Generate one with
#   openssl rand -base64 32
# and set it before the first start. If it is empty, TasmoAdmin generates a
# key and keeps it in .device-password.key in the data volume. Without the
# same key, a new installation cannot read the stored passwords, so keep a
# copy of it.
TASMO_DEVICE_PASSWORD_KEY=

# Read the key from a file instead, e.g. a Docker secret. If both
# TASMO_DEVICE_PASSWORD_KEY and this are set, they must contain the same key.
#TASMO_DEVICE_PASSWORD_KEY_FILE=/run/secrets/tasmoadmin_password_key


# --- Web access ---------------------------------------------------------------

# Base URL when TasmoAdmin is served below a path of a reverse proxy, with a
# leading and a trailing slash. Detected automatically when not set.
#TASMO_BASEURL=/tasmoadmin/

# Set to true to skip TasmoAdmin's own login when authentication is handled
# in front of it (reverse proxy, SSO). Anyone who can reach TasmoAdmin then
# has full access.
NO_AUTH=false

# Set to true to allow embedding TasmoAdmin in a page of another HTTPS site
# (Home Assistant, Organizr). Plain HTTP requests stay restricted.
TASMO_ALLOW_CROSS_SITE_IFRAME=false


# --- Paths --------------------------------------------------------------------

# Data directory, with a trailing slash. In the Docker image the data volume
# (/data/tasmoadmin) is used when this is not set.
#TASMO_DATADIR=/data/tasmoadmin/

# Directory for sessions and caches, with a trailing slash. Defaults to the
# tmp folder of the application.
#TASMO_TMPDIR=/var/www/tasmoadmin/tmp/


# --- Troubleshooting ----------------------------------------------------------

# Set to true to show PHP errors in the browser.
TASMO_DEBUG=false
